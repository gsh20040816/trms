TRMS_PUBLIC_HTTP_PORT=8080

TRMS_POSTGRES_DB=trms
TRMS_POSTGRES_USER=trms
TRMS_POSTGRES_PASSWORD=replace-with-postgres-password

TRMS_MINIO_ROOT_USER=replace-with-minio-root-user
TRMS_MINIO_ROOT_PASSWORD=replace-with-minio-root-password

DATABASE_URL=postgresql+psycopg://trms:replace-with-postgres-password@postgres:5432/trms

TRMS_ENV=production
TZ=Asia/Shanghai
TRMS_STORAGE_BACKEND=s3
TRMS_STORAGE_S3_ENDPOINT=http://minio:9000
TRMS_STORAGE_S3_BUCKET=trms-prod
TRMS_STORAGE_S3_ACCESS_KEY_ID=replace-with-minio-access-key
TRMS_STORAGE_S3_SECRET_ACCESS_KEY=replace-with-minio-secret-key
TRMS_STORAGE_S3_REGION=us-east-1
TRMS_STORAGE_S3_KEY_PREFIX=prod

TRMS_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
TRMS_PUBLIC_API_BASE_URL=http://localhost:8080/api
TRMS_PUBLIC_WEB_BASE_URL=http://localhost:8080
TRMS_API_HOST=0.0.0.0
TRMS_API_PORT=9876

TRMS_ASYNC_JOB_MODE=worker
TRMS_ASYNC_JOB_POLL_INTERVAL_SECONDS=5
TRMS_ASYNC_JOB_WORKER_CONCURRENCY=4

TRMS_AUTH_ALLOW_ADMIN_SELF_REGISTER=false
TRMS_AUTH_BOOTSTRAP_ADMIN_TOKEN=replace-with-bootstrap-admin-token
TRMS_AUTH_TELEGRAM_INBOUND_TOKEN=replace-with-telegram-inbound-token
TRMS_AUTH_EMAIL_INBOUND_TOKEN=replace-with-email-inbound-token
TRMS_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TRMS_TELEGRAM_WEBHOOK_SECRET=replace-with-telegram-webhook-secret
TRMS_SMTP_HOST=smtp.example.edu
TRMS_SMTP_PORT=587
TRMS_SMTP_USERNAME=mailer@example.edu
TRMS_SMTP_PASSWORD=replace-with-smtp-password
TRMS_SMTP_FROM_ADDRESS=trms@example.edu
TRMS_SMTP_STARTTLS=true
TRMS_SMTP_USE_SSL=false
TRMS_SMTP_TIMEOUT_SECONDS=15
TRMS_IMAP_HOST=imap.example.edu
TRMS_IMAP_PORT=993
TRMS_IMAP_USERNAME=trms@example.edu
TRMS_IMAP_PASSWORD=replace-with-imap-password
TRMS_IMAP_MAILBOX=INBOX
TRMS_IMAP_POLL_INTERVAL_SECONDS=30
TRMS_IMAP_USE_SSL=true
TRMS_IMAP_STARTTLS=false

TRMS_TEXT_LLM_BASE_URL=https://api.openai.com/v1
TRMS_TEXT_LLM_API_KEY=replace-with-text-llm-api-key
TRMS_TEXT_LLM_MODEL=gpt-4.1-mini
TRMS_TEXT_LLM_TIMEOUT_SECONDS=30
TRMS_TEXT_LLM_MAX_RETRIES=2

TRMS_VLM_BASE_URL=https://api.openai.com/v1
TRMS_VLM_API_KEY=replace-with-vlm-api-key
TRMS_VLM_MODEL=gpt-4.1-mini
TRMS_VLM_TIMEOUT_SECONDS=30
TRMS_VLM_MAX_RETRIES=2

TRMS_WEB_HOST=127.0.0.1
TRMS_WEB_PORT=5173
VITE_API_BASE_URL=/api
