TRMS_ENV=development
TZ=Asia/Shanghai

DATABASE_URL=sqlite:///./trms.db

TRMS_STORAGE_BACKEND=local
MATERIAL_STORAGE_DIR=./data/materials

TRMS_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRMS_PUBLIC_API_BASE_URL=http://127.0.0.1:9876/api
TRMS_PUBLIC_WEB_BASE_URL=http://127.0.0.1:5173
TRMS_PUBLIC_EMAIL_SUBMISSION_ADDRESS=
TRMS_TELEGRAM_BOT_URL=
TRMS_API_HOST=127.0.0.1
TRMS_API_PORT=9876

TRMS_ASYNC_JOB_MODE=in_process
TRMS_ASYNC_JOB_POLL_INTERVAL_SECONDS=5
TRMS_ASYNC_JOB_WORKER_CONCURRENCY=4
TRMS_ASYNC_JOB_WORKER_TASK_TIMEOUT_SECONDS=300

TRMS_AUTH_ALLOW_ADMIN_SELF_REGISTER=true
TRMS_AUTH_TELEGRAM_INBOUND_TOKEN=
TRMS_AUTH_EMAIL_INBOUND_TOKEN=
TRMS_TELEGRAM_BOT_TOKEN=
TRMS_TELEGRAM_WEBHOOK_SECRET=
TRMS_SMTP_HOST=
TRMS_SMTP_PORT=
TRMS_SMTP_USERNAME=
TRMS_SMTP_PASSWORD=
TRMS_SMTP_FROM_ADDRESS=
TRMS_SMTP_STARTTLS=true
TRMS_SMTP_USE_SSL=false
TRMS_SMTP_TIMEOUT_SECONDS=15
TRMS_IMAP_HOST=
TRMS_IMAP_PORT=
TRMS_IMAP_USERNAME=
TRMS_IMAP_PASSWORD=
TRMS_IMAP_MAILBOX=INBOX
TRMS_IMAP_POLL_INTERVAL_SECONDS=30
TRMS_IMAP_USE_SSL=true
TRMS_IMAP_STARTTLS=false

TRMS_TEXT_LLM_BASE_URL=
TRMS_TEXT_LLM_API_KEY=
TRMS_TEXT_LLM_MODEL=
TRMS_TEXT_LLM_TIMEOUT_SECONDS=
TRMS_TEXT_LLM_MAX_RETRIES=

TRMS_VLM_BASE_URL=
TRMS_VLM_API_KEY=
TRMS_VLM_MODEL=
TRMS_VLM_TIMEOUT_SECONDS=
TRMS_VLM_MAX_RETRIES=

TRMS_WEB_HOST=127.0.0.1
TRMS_WEB_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:9876/api
